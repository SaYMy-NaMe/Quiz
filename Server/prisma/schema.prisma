// Quiz Platform — data model.
//
// Local development uses SQLite. To move to PostgreSQL (e.g. Supabase):
//   1. change `provider = "sqlite"` to `provider = "postgresql"` below
//   2. point DATABASE_URL at the Postgres connection string (Supabase: the "Transaction" pooler
//      URL, plus DIRECT_URL for migrations if you use the pooler)
//   3. run `npx prisma migrate dev --name init-postgres` once to create Postgres migrations
// No repository, service or router code changes: JSON columns are stored as String and
// (de)serialised at the repository boundary, and all ids/timestamps are portable types.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Instructor {
  id           String    @id
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at")
  sessions     Session[]
  quizzes      Quiz[]

  @@map("instructors")
}

model Session {
  id           String     @id
  instructorId String     @map("instructor_id")
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  expiresAt    DateTime   @map("expires_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([instructorId])
  @@map("sessions")
}

model Quiz {
  id              String       @id
  ownerId         String       @map("owner_id")
  owner           Instructor   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  description     String       @default("")
  /// draft | published | closed
  status          String       @default("draft")
  /// public | restricted
  accessMode      String       @default("public") @map("access_mode")
  shareToken      String?      @unique @map("share_token")
  durationSeconds Int          @default(600) @map("duration_seconds")
  revealAnswers   Boolean      @default(false) @map("reveal_answers")
  revealScores    Boolean      @default(true) @map("reveal_scores")
  /// JSON: SchemaField[]
  examineeFields  String       @default("[]") @map("examinee_fields")
  /// JSON: Question[] (includes answer keys — never sent to examinees)
  questions       String       @default("[]")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  invites         Invite[]
  attempts        Attempt[]
  submissions     Submission[]

  @@index([ownerId])
  @@map("quizzes")
}

model Invite {
  id        String   @id
  quizId    String   @map("quiz_id")
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  email     String
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([quizId, email])
  @@map("invites")
}

model Attempt {
  id              String           @id
  quizId          String           @map("quiz_id")
  quiz            Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  /// JSON: ExamineeRecord
  examinee        String
  /// in_progress | submitted
  status          String           @default("in_progress")
  startedAt       DateTime         @map("started_at")
  expiresAt       DateTime         @map("expires_at")
  violations      Int              @default(0)
  submission      Submission?
  violationEvents ViolationEvent[]

  @@index([quizId])
  @@map("attempts")
}

model Submission {
  id              String   @id
  quizId          String   @map("quiz_id")
  quiz            Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  attemptId       String   @unique @map("attempt_id")
  attempt         Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  /// JSON: ExamineeRecord
  examinee        String
  /// JSON: AnswerMap
  answers         String
  score           Float
  maxScore        Float    @map("max_score")
  durationSeconds Int      @map("duration_seconds")
  startedAt       DateTime @map("started_at")
  submittedAt     DateTime @map("submitted_at")
  violations      Int      @default(0)
  /// manual | timeout | violation
  reason          String   @default("manual")

  @@index([quizId])
  @@index([quizId, score, durationSeconds, submittedAt])
  @@map("submissions")
}

model ViolationEvent {
  id         String   @id
  attemptId  String   @map("attempt_id")
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  kind       String
  occurredAt DateTime @map("occurred_at")

  @@index([attemptId])
  @@map("violation_events")
}
