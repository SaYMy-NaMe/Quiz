{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "paths": {
      "@shared/*": [
        "./src/shared/*"
      ],
      "@shared": [
        "./src/shared/index.ts"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/* 2*",
    "**/* 3*",
    "**/* 4*"
  ]
}
