# ---- Server ------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---- Database (Prisma) -------------------------------------------------------
# SQLite for local development. Relative "file:" paths resolve from the prisma/ directory,
# so this lands in server/data/quiz.db. The file and every table are created automatically
# on startup (AUTO_MIGRATE) — no manual setup.
DATABASE_URL="file:../data/quiz.db"
# PostgreSQL / Supabase (also set provider = "postgresql" in prisma/schema.prisma):
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# Apply pending migrations at boot (recommended for SQLite / single-instance deployments).
AUTO_MIGRATE=true

# ---- Files & client ------------------------------------------------------------
UPLOAD_DIR=./uploads
# Origin allowed for CORS with credentials (the client dev server / hosted client).
CLIENT_ORIGIN=http://localhost:5173
# Built client to serve from this process with an SPA fallback (optional).
CLIENT_DIST=../client/dist

# ---- Sessions & security -------------------------------------------------------
SESSION_TTL_HOURS=72
# lax | strict | none — use none (with HTTPS=true) when the client is on a different site.
COOKIE_SAMESITE=lax
# true only behind TLS; otherwise browsers on other devices upgrade http asset URLs and break.
HTTPS=false
