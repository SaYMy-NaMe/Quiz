# Base URL (origin) of the API server — no trailing slash, no /api suffix.
# Leave EMPTY for same-origin mode (Vite proxy in dev, or Express serving the build).
#
# Which file Vite reads depends on the mode:
#   npm run dev         -> .env.development  (local API, http://localhost:4000)
#   npm run dev:remote  -> .env.remote       (hosted API while developing)
#   npm run build       -> .env.production   (hosted API)
#   .env.local          -> personal override for any mode (git-ignored)
VITE_API_BASE_URL=http://localhost:4000
